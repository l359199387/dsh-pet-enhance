{
  "name": "dsh-pet-enhance",
  "version": "1.0.0",
  "description": "dsh-pet-enhance：给 dsh-pet 增强看屏、教学与授权动手能力（小蓝鲸）。",
  "type": "module",
  "main": "./packages/dsh-pet-enhance/src/index.js",
  "exports": {
    ".": "./packages/dsh-pet-enhance/src/index.js",
    "./client": "./packages/dsh-pet-enhance/client.js",
