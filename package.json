    "./package.json": "./package.json"
  },
  "files": [
    "packages/dsh-pet-enhance/src",
    "packages/dsh-pet-enhance/sidecar",
    "packages/dsh-pet-enhance/assets",
    "packages/dsh-pet-enhance/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node tools/dev-check.mjs"
  },
